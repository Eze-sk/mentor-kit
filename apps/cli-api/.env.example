# Turso (libSQL) database connection URL.
# Format: libsql://<database-name>-<org>.turso.io
# Example: libsql://my-scraper-db-myorg.turso.io
DATABASE_URL=

# Turso (libSQL) authentication token used to authorize requests to the database.
# Generate one from the Turso dashboard or via `turso db tokens create`.
# Example: eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...
DATABASE_TOKEN=
